+out=root/'checkpoints/2026-10-16-race-foundation/evidence';out.mkdir(parents=True,exist_ok=True)
+views={
+ 'baseline':['--cheeky','--mode','heist','--bots','11','--cam','0,5,20,0,-10,78'],
