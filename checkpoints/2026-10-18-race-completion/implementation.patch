+            self.attempts.pop_front();
+            if hit {
+                let reward = self.next();
+                self.score = self.score.saturating_add(reward);
+                gain += reward;
+                self.streak += 1;
+                self.hits += 1;
+            } else {
+                self.streak = 0;
+            }
+        }
+        gain
+    }
